---
import SectionLabel from "~/components/SectionLabel.astro";
import { getCollection } from "astro:content";

const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<SectionLabel index="04" label="Toolkit / the stack I reach for" anchor="skills" />

<section class="relative">
  <div class="container-x grid gap-6 md:gap-8 md:grid-cols-12">
    <div class="md:col-span-4 in-view">
      <h3 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.05]" style="color: var(--fg);">
        A carefully curated
        <span class="display-italic" style="color: var(--accent);"> toolbelt</span> &mdash; not a dump of every logo on the internet.
      </h3>
      <p class="mt-5 max-w-[38ch]" style="color: var(--fg-soft);">
        I prefer to go deep on a few tools rather than shallow on many. These are the ones I&rsquo;ve actually shipped with.
      </p>
    </div>

    <div class="md:col-span-8 in-view">
      <ul class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x" style="border-color: var(--line);">
        {skills.map((group) => (
          <li class="py-6 sm:py-0 sm:px-6 first:sm:pl-0 last:sm:pr-0" style="border-color: var(--line);">
            <p class="eyebrow">{group.data.category}</p>
            <ul class="mt-4 space-y-2">
              {group.data.items.map((item) => (
                <li class="flex items-center gap-3 font-display text-lg" style="color: var(--fg);">
                  <span class="h-1 w-3 shrink-0" style="background: var(--accent);"></span>
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
