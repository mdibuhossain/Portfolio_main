---
import SectionLabel from "~/components/SectionLabel.astro";
import { getCollection } from "astro:content";

const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<SectionLabel index="04" label="Toolkit / the stack I reach for" anchor="skills" />

<section class="relative pb-8">
  <div class="container-x">

    <div class="grid md:grid-cols-12 gap-6 mb-12 md:mb-16">
      <div class="md:col-span-5 in-view">
        <h3 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.05]" style="color: var(--fg);">
          A carefully curated
          <span class="display-italic" style="color: var(--accent);"> toolbelt</span> &mdash; not a dump of every logo on the internet.
        </h3>
        <p class="mt-5 max-w-[38ch]" style="color: var(--fg-soft);">
          I prefer to go deep on a few tools rather than shallow on many. These are the ones I&rsquo;ve actually shipped with.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {skills.map((group, i) => (
        <div
          class="skill-card in-view"
          style={`transition-delay: ${i * 0.06}s;`}
        >
          <div class="skill-card-inner">
            <div class="flex items-baseline justify-between mb-5">
              <span class="eyebrow">{group.data.category}</span>
              <span class="skill-index">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {group.data.items.map((item) => (
                <span class="skill-pill">{item}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
