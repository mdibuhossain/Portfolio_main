---
---
<button
  id="theme-toggle"
  class="inline-flex items-center justify-center rounded-full border p-2 transition-colors"
  style="border-color: var(--line); color: var(--fg-soft);"
  aria-label="Toggle theme"
  type="button"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="block" data-icon="dark" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="hidden" data-icon="light" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
</button>

<script is:inline>
  function wireTheme() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const dark = btn.querySelector('[data-icon="dark"]');
    const light = btn.querySelector('[data-icon="light"]');
    const sync = () => {
      const t = document.documentElement.getAttribute("data-theme") || "dark";
      if (t === "dark") { dark.classList.remove("hidden"); light.classList.add("hidden"); }
      else { dark.classList.add("hidden"); light.classList.remove("hidden"); }
    };
    sync();
    btn.onclick = () => {
      const t = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", t);
      try { localStorage.setItem("theme", t); } catch (_) {}
      sync();
    };
  }
  wireTheme();
  document.addEventListener("astro:page-load", wireTheme);
</script>
