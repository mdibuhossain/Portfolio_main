---
interface Props {
  items: string[];
  separator?: string;
}
const { items, separator = "/" } = Astro.props;
const loop = [...items, ...items];
---

<div class="overflow-hidden" style="mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);">
  <div class="marquee py-5">
    {loop.map((it, i) => (
      <span class="flex items-center shrink-0 px-6 font-display text-[clamp(2rem,5vw,3.5rem)]" style={`color: ${i % 3 === 0 ? "var(--accent)" : "var(--fg-soft)"};`}>
        <span class="italic mr-6" style="color: var(--muted);">{separator}</span>
        {it}
      </span>
    ))}
  </div>
</div>
