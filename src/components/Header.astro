---
import { getEntry } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

const site = await getEntry("site", "site");
const cfg = site!.data;

const nav = [
  { label: "Work", href: "/#work" },
  { label: "Experience", href: "/#experience" },
  { label: "About", href: "/#about" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/#contact" },
];
---

<header
  class="sticky top-0 z-40 backdrop-blur-md"
  style="background: color-mix(in oklab, var(--bg) 70%, transparent); border-bottom: 1px solid var(--line-soft);"
>
  <div class="container-x flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-2 group" aria-label={`${cfg.name} — home`}>
      <span
        class="grid h-9 w-9 place-items-center rounded-full border transition-transform duration-500 group-hover:rotate-[360deg]"
        style="background: var(--bg-elev); border-color: var(--line);"
      >
        <span class="font-display text-[1rem] leading-none" style="color: var(--accent);">I</span>
      </span>
      <span class="hidden sm:block font-mono text-[0.72rem] uppercase tracking-[0.22em]" style="color: var(--muted);">
        Ibrahim Hossain<span class="mx-1" style="color: var(--line);">/</span>
        <span style="color: var(--fg-soft);">Software Engineer</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class="font-mono text-[0.72rem] uppercase tracking-[0.22em] transition-colors hover:text-[var(--accent)]"
          style="color: var(--fg-soft);"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="#contact"
        class="btn-primary hidden sm:inline-flex"
        style="padding: 0.55rem 1rem; font-size: 0.68rem;"
      >
        Say hi
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M1 9L9 1M9 1H2.5M9 1V7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </a>
      <button
        id="menu-btn"
        class="md:hidden inline-flex items-center justify-center rounded-full border p-2"
        style="border-color: var(--line); color: var(--fg-soft);"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 7H21M3 12H21M3 17H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="menu-panel"
    class="md:hidden hidden border-t"
    style="border-color: var(--line-soft); background: var(--bg);"
  >
    <nav class="container-x py-6 flex flex-col gap-4" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="font-display text-3xl"
          data-close-menu
          style="color: var(--fg);"
        >
          {item.label}.
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  function wireMenu() {
    const btn = document.getElementById("menu-btn");
    const panel = document.getElementById("menu-panel");
    if (!btn || !panel) return;
    const toggle = () => {
      const open = panel.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    };
    btn.onclick = toggle;
    panel.querySelectorAll("[data-close-menu]").forEach((a) => (a.onclick = () => panel.classList.add("hidden")));
  }
  wireMenu();
  document.addEventListener("astro:page-load", wireMenu);
</script>
