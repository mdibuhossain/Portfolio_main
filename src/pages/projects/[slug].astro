---
import Base from "~/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const idx = projects.findIndex((x) => x.id === entry.id);
const next = projects[(idx + 1) % projects.length];
---

<Base title={p.title} description={p.tagline}>
  <article>
    <!-- Hero panel -->
    <section class="pt-12 md:pt-16 pb-20">
      <div class="container-x grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 flex items-center gap-4">
          <a href="/projects" class="font-mono text-[0.72rem] uppercase tracking-[0.22em]" style="color: var(--muted);">
            &larr; Back to projects
          </a>
          <span class="hairline flex-1"></span>
          <span class="font-mono text-[0.72rem] uppercase tracking-[0.2em]" style="color: var(--accent);">
            &#x2022; {p.status === "live" ? "LIVE" : p.status === "wip" ? "IN PROGRESS" : "ARCHIVED"} &middot; {p.year}
          </span>
        </div>

        <div class="col-span-12 md:col-span-8">
          <p class="eyebrow mb-4">Project</p>
          <h1 class="display text-[clamp(2.75rem,8vw,7rem)]" style="color: var(--fg);">
            {p.title.split(" ").slice(0, -1).join(" ")}
            <span class="display-italic" style="color: var(--accent);"> {p.title.split(" ").at(-1)}.</span>
          </h1>
          <p class="mt-6 max-w-[60ch] font-display text-[clamp(1.25rem,2vw,1.6rem)] leading-[1.35]" style="color: var(--fg-soft);">
            {p.tagline}
          </p>
        </div>

        <aside class="col-span-12 md:col-span-4 md:pt-10">
          <div class="card p-6">
            <dl class="space-y-4">
              <div class="flex items-center justify-between">
                <dt class="eyebrow">Role</dt>
                <dd class="font-mono text-sm text-right" style="color: var(--fg);">{p.role}</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="eyebrow">Year</dt>
                <dd class="font-mono text-sm" style="color: var(--fg);">{p.year}</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="eyebrow">Status</dt>
                <dd class="font-mono text-sm" style="color: var(--fg);">
                  {p.status === "live" ? "Live" : p.status === "wip" ? "Work in progress" : "Archived"}
                </dd>
              </div>
            </dl>
            {(p.liveUrl || p.sourceUrl) && (
              <div class="mt-5 pt-5 border-t space-y-2" style="border-color: var(--line);">
                {p.liveUrl && (
                  <a href={p.liveUrl} target="_blank" rel="noopener" class="flex items-center justify-between font-mono text-sm link-underline" style="color: var(--fg);">
                    Visit live <span style="color: var(--accent);">&rarr;</span>
                  </a>
                )}
                {p.sourceUrl && (
                  <a href={p.sourceUrl} target="_blank" rel="noopener" class="flex items-center justify-between font-mono text-sm link-underline" style="color: var(--fg);">
                    Source code <span style="color: var(--accent);">&rarr;</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </aside>
      </div>
    </section>

    <!-- Cover -->
    <section class="container-x">
      <div
        class="relative aspect-[16/7] w-full overflow-hidden rounded-3xl"
        style={`background: linear-gradient(135deg, ${p.cover.from}, ${p.cover.to});`}
      >
        <div
          class="absolute inset-0 opacity-30"
          style="background-image: radial-gradient(rgba(0,0,0,.2) 1px, transparent 1px); background-size: 28px 28px;"
        ></div>
        <div class="absolute inset-0 grid place-items-center">
          <span
            class="font-display text-[clamp(6rem,22vw,16rem)] leading-none"
            style="color: rgba(255,255,255,.95); mix-blend-mode: overlay; letter-spacing: -0.04em;"
          >
            {p.cover.text}
          </span>
        </div>
      </div>
    </section>

    <!-- Body -->
    <section class="container-x grid grid-cols-12 gap-x-6 pt-20 pb-10">
      <div class="col-span-12 md:col-span-8 md:col-start-3">
        <p class="font-display text-[clamp(1.5rem,2.6vw,2.25rem)] leading-[1.3] mb-10" style="color: var(--fg);">
          {p.summary}
        </p>
        <div class="prose-editorial">
          <Content />
        </div>

        <div class="mt-14 pt-6 border-t" style="border-color: var(--line);">
          <p class="eyebrow mb-4">Stack</p>
          <ul class="flex flex-wrap gap-2">
            {p.stack.map((s) => (
              <li class="font-mono text-[0.72rem] uppercase tracking-widest px-3 py-1 rounded-full border" style="color: var(--fg-soft); border-color: var(--line);">{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Next -->
    <section class="container-x pt-20">
      <div class="flex items-end justify-between gap-6 border-t pt-8" style="border-color: var(--line);">
        <div>
          <p class="eyebrow mb-2">Up next</p>
          <a href={`/projects/${next.id}`} class="font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]" style="color: var(--fg);">
            {next.data.title} <span class="display-italic" style="color: var(--accent);">&rarr;</span>
          </a>
        </div>
        <a href="/projects" class="hidden md:inline-flex link-underline font-mono text-[0.72rem] uppercase tracking-[0.22em]" style="color: var(--fg-soft);">
          All projects
        </a>
      </div>
    </section>
  </article>
</Base>
